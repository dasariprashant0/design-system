{
  "$description": "Monoline design tokens, generated from packages/css/src/{tokens,accents,options}.css. Edit the CSS and run node packages/tokens/scripts/build.mjs.",
  "base": {
    "code": {
      "keyword": {
        "$value": "#FF9A70",
        "$type": "color"
      },
      "string": {
        "$value": "#A8E6A1",
        "$type": "color"
      },
      "number": {
        "$value": "#F5CD7A",
        "$type": "color"
      },
      "comment": {
        "$value": "#9A9EAD",
        "$type": "color"
      },
      "tag": {
        "$value": "#7FC8FF",
        "$type": "color"
      },
      "attr": {
        "$value": "#F0A8D4",
        "$type": "color"
      },
      "fn": {
        "$value": "#D6B4FF",
        "$type": "color"
      }
    },
    "type": {
      "font-display": {
        "$value": "\"Space Mono\", ui-monospace, monospace"
      },
      "font-body": {
        "$value": "\"DM Mono\", ui-monospace, monospace"
      },
      "text-xs": {
        "$value": "11px",
        "$type": "dimension"
      },
      "text-sm": {
        "$value": "13px",
        "$type": "dimension"
      },
      "text-base": {
        "$value": "15px",
        "$type": "dimension"
      },
      "text-lg": {
        "$value": "18px",
        "$type": "dimension"
      },
      "display-sm": {
        "$value": "clamp(28px, 3.4vw, 40px)"
      },
      "display-md": {
        "$value": "clamp(34px, 5vw, 64px)"
      },
      "display-xl": {
        "$value": "clamp(44px, 8vw, 104px)"
      }
    },
    "color": {
      "rule": {
        "$value": "color-mix(in srgb, var(--foreground) 20%, transparent)",
        "$type": "color"
      },
      "wash": {
        "$value": "color-mix(in srgb, var(--foreground) 4%, transparent)",
        "$type": "color"
      },
      "wash-2": {
        "$value": "color-mix(in srgb, var(--foreground) 9%, transparent)",
        "$type": "color"
      },
      "ink-1": {
        "$value": "var(--foreground)",
        "$type": "color"
      },
      "ink-2": {
        "$value": "color-mix(in srgb, var(--foreground) 70%, transparent)",
        "$type": "color"
      },
      "ink-3": {
        "$value": "color-mix(in srgb, var(--foreground) 45%, transparent)",
        "$type": "color"
      },
      "ink-4": {
        "$value": "color-mix(in srgb, var(--foreground) 25%, transparent)",
        "$type": "color"
      },
      "ink-5": {
        "$value": "color-mix(in srgb, var(--foreground) 10%, transparent)",
        "$type": "color"
      },
      "hatch": {
        "$value": "repeating-linear-gradient(135deg, var(--muted) 0 1.5px, transparent 1.5px 7px)"
      }
    },
    "space": {
      "s1": {
        "$value": "4px",
        "$type": "dimension"
      },
      "s2": {
        "$value": "8px",
        "$type": "dimension"
      },
      "s3": {
        "$value": "12px",
        "$type": "dimension"
      },
      "s4": {
        "$value": "16px",
        "$type": "dimension"
      },
      "s5": {
        "$value": "24px",
        "$type": "dimension"
      },
      "s6": {
        "$value": "32px",
        "$type": "dimension"
      },
      "s7": {
        "$value": "48px",
        "$type": "dimension"
      },
      "s8": {
        "$value": "64px",
        "$type": "dimension"
      },
      "s9": {
        "$value": "96px",
        "$type": "dimension"
      }
    },
    "control": {
      "sm": {
        "$value": "calc(var(--s6) + var(--s1))"
      },
      "md": {
        "$value": "var(--s7)"
      },
      "lg": {
        "$value": "calc(var(--s7) + var(--s2))"
      }
    },
    "radius": {
      "radius": {
        "$value": "0"
      },
      "round": {
        "$value": "999px",
        "$type": "dimension"
      }
    },
    "motion": {
      "ease": {
        "$value": "cubic-bezier(0.76, 0, 0.24, 1)"
      },
      "fast": {
        "$value": "0.12s"
      },
      "base": {
        "$value": "0.2s"
      },
      "slow": {
        "$value": "0.45s"
      }
    },
    "layout": {
      "side": {
        "$value": "264px",
        "$type": "dimension"
      },
      "measure": {
        "$value": "64ch"
      },
      "content": {
        "$value": "1080px",
        "$type": "dimension"
      },
      "window-pad": {
        "$value": "var(--s6)"
      }
    },
    "zIndex": {
      "drawer": {
        "$value": "40"
      },
      "grain": {
        "$value": "50"
      },
      "toast": {
        "$value": "60"
      }
    }
  },
