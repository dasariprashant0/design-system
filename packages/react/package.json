{
  "name": "@monoline/react",
  "version": "0.3.0",
  "description": "Monoline React components: accessible, typed, styled by @monoline/css.",
  "license": "MIT",
  "type": "module",
  "repository": {"type": "git", "url": "git+https://github.com/dasariprashant0/design-system.git", "directory": "packages/react"},
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {"types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs"}
  },
  "sideEffects": false,
  "files": ["dist", "src"],
  "scripts": {
    "gen": "node scripts/gen-index.mjs",
    "registry": "node scripts/gen-registry.mjs",
    "build": "npm run gen && vite build",
    "dev": "vite build --watch",
    "test": "npm run gen && vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run gen && tsc --noEmit",
    "check:docs": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "radix-ui": "^1.4.2"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@monoline/css": "*",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.2.0",
    "vitest-axe": "^0.1.0"
  }
}
