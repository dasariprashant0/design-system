{
  "name": "docs",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "gen": "node scripts/gen-props.mjs && node scripts/gen-demos.mjs && node scripts/gen-styling.mjs && node scripts/gen-markdown.mjs && node scripts/gen-size.mjs",
    "predev": "npm run gen",
    "dev": "vite",
    "prebuild": "npm run gen",
    "build": "vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:docs": "node --test scripts"
  },
  "dependencies": {
    "@monoline/react": "*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@monoline/css": "*",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
